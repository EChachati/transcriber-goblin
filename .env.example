# Genera un par nuevo con:
#   docker run --rm ghcr.io/jamsocket/y-sweet:latest y-sweet gen-auth --json
YSWEET_PRIVATE_KEY=pega-aqui-private_key
YSWEET_SERVER_TOKEN=pega-aqui-server_token

ADMIN_TOKEN=cualquier-string-largo-y-aleatorio

# URL con la que los CLIENTES (plugin/web) alcanzan y-sweet.
# En local: ws://localhost:7700 | En VPS: wss://sync.tudominio.com
YSWEET_PUBLIC_URL=ws://localhost:7700
