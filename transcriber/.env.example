# Configuración del transcriptor

# Backend API (opcional, solo necesario con --publish)
TG_API_URL=http://localhost:8000
TG_TOKEN=

# Directorio para sesiones locales (grabaciones, transcript.json, transcript.md)
TG_SESSIONS_DIR=~/.local/share/tg-transcriber/sessions

# Obsidian integration
# Ruta absoluta al vault de Obsidian
TG_OBSIDIAN_VAULT=
# Carpeta dentro del vault para guardar las transcripciones (opcional)
TG_OBSIDIAN_FOLDER=Transcripciones
