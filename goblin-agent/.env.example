# Configuración del goblin-agent
# Copia este archivo a .env y ajusta lo que necesites.

# Vault original (SOLO LECTURA — nunca se escribe aquí)
TG_GOBLIN_SOURCE_VAULT=~/Documents/CurseOfStrahd

# Copia de trabajo (aquí se escribe todo)
TG_GOBLIN_WORK_VAULT=~/Documents/TranscriberGoblin/CurseOfStrahd-Goblin

# Nombre de la campaña (aparece en "Anteriormente en ...")
TG_GOBLIN_CAMPAIGN=Curse of Strahd

# Ollama
# Modelo: qwen2.5:3b es rápido pero flojo (se le escapan hechos); qwen2.5:7b
# da un borrador bastante mejor (~40-60 s por tramo con 4 GB de VRAM).
TG_GOBLIN_OLLAMA_URL=http://localhost:11434
TG_GOBLIN_MODEL=qwen2.5:3b
TG_GOBLIN_NUM_CTX=8192
# Tope de tokens que puede generar el modelo en cada llamada
TG_GOBLIN_NUM_PREDICT=3072
TG_GOBLIN_TEMPERATURE=0.3

# Idioma del resumen (código ISO: es, en, ...)
TG_GOBLIN_LANGUAGE=es

# Troceo híbrido
TG_GOBLIN_CHUNK_CHARS=4000
TG_GOBLIN_CHUNK_OVERLAP=2
TG_GOBLIN_LOOKAHEAD=6

# Referencias del vault
TG_GOBLIN_MAX_REF_NOTES=6
TG_GOBLIN_MAX_REF_CHARS=1200
TG_GOBLIN_MAX_REF_TOTAL=5000

# Generación del cuerpo por lotes.
# Las notas de cada tramo se agrupan en lotes de como mucho N caracteres y de
# cada lote se pide UNA sección. Bájalo si tu modelo se queda sin contexto
# (num_ctx); súbelo para hacer menos llamadas.
TG_GOBLIN_BODY_BATCH_CHARS=6000
